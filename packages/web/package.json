{
  "name": "@earendil-works/dcma-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import ../coding-agent/src/experimental/source-resolver.ts server.ts",
    "knowledge:ingest": "python knowledge/scripts/ingest.py && python knowledge/scripts/validate.py",
    "knowledge:build": "node --import ../coding-agent/src/experimental/source-resolver.ts knowledge-build.ts",
    "knowledge:reindex": "node --import ../coding-agent/src/experimental/source-resolver.ts knowledge-reindex.ts",
    "build": "vite build",
    "preview": "node --import ../coding-agent/src/experimental/source-resolver.ts server.ts --production",
    "start": "node --import ../coding-agent/src/experimental/source-resolver.ts server.ts --production",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test:tools": "node --import ../coding-agent/src/experimental/source-resolver.ts --test test/industrial-tools.test.ts test/tool-trace.test.ts test/tool-registry.test.ts test/telemetry.test.ts test/chart-*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.1.0",
    "echarts": "6.1.0",
    "lucide-react": "1.52.0",
    "mysql2": "3.24.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.24",
    "tailwindcss": "3.4.19",
    "vite": "6.4.4"
  }
}
